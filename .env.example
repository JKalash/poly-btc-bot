# --- Deployment / secrets ONLY. Risk limits are configured in the database
# --- (config versions) and can NOT be overridden from the environment.

# Postgres. Leave unset to use embedded PGlite (zero-install dev mode, single process).
# DATABASE_URL=postgres://b5p:b5p@127.0.0.1:5432/b5p

# Redis. Leave unset to use the in-process event bus (requires combined dev mode).
# REDIS_URL=redis://127.0.0.1:6379

# Where PGlite stores its data files in embedded mode.
PGLITE_DIR=./data/pglite

# API
API_HOST=127.0.0.1
API_PORT=8787
# Session cookie signing secret. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-real-secret

# Single-operator auth. Generate a hash with: pnpm --filter @b5p/api hash-password
# Default dev credentials (CHANGE THEM): operator / operator
OPERATOR_USERNAME=operator
# scrypt hash, format: scrypt$N$r$p$salthex$hashhex
OPERATOR_PASSWORD_HASH=

# Web
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787

# --- LIVE TRADING (disabled; the adapter is a stub in this release) ---
# No private key configuration exists in this release on purpose.
# See docs/live-trading-checklist.md before any future enablement.
LIVE_TRADING_ENABLED=false
